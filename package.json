{
  "name": "chatbot-platform",
  "version": "1.0.0",
  "main": "server.js",
  "description": "Multi-tenant customer support chat platform with a visual workflow editor",
  "scripts": {
    "build": "node scripts/build-client.js",
    "prestart": "npm run build",
    "start": "node server.js",
    "predev": "npm run build",
    "dev": "node scripts/build-client.js --watch & nodemon --ignore public/dist --ignore client server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=tests/.*\\.test\\.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "security-audit": "node scripts/security-audit.js",
    "docker:build": "docker build -t chatbot-platform .",
    "docker:up": "docker compose up -d --build"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.10.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "connect-mongo": "^6.0.0",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "express-prom-bundle": "^8.0.0",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "google-spreadsheet": "^4.1.4",
    "googleapis": "^124.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.15.1",
    "multer": "^2.0.0",
    "node-cron": "^4.1.1",
    "nodemailer": "^10.0.1",
    "openai": "^5.0.1",
    "pdf-parse": "^2.4.5",
    "prom-client": "^15.1.3",
    "redis": "^6.2.1",
    "socket.io": "^4.8.1",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "bootstrap": "^5.3.8",
    "chart.js": "^4.5.1",
    "esbuild": "^0.25.12",
    "eslint": "^8.57.0",
    "feather-icons": "^4.29.2",
    "jest": "^29.7.0",
    "marked": "^15.0.12",
    "mongodb-memory-server": "^8.15.1",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.1"
  }
}

# Dependencies are installed inside the image from package-lock.json.
node_modules
npm-debug.log*
yarn-*.log

# Secrets: the image must never contain a real .env. Configuration is passed
# at run time (docker run --env-file / compose env_file).
.env
.env.*
!.env.example

# Generated at runtime; mounted as volumes in production.
logs
backups
uploads
widget-versions
*.log
*.tar.gz

# Tests, tooling and reports have no place in the runtime image.
tests
coverage
.nyc_output
.eslintcache
.mongodb-memory-server
load-test-results
security-reports
jest.config.js
.eslintrc.js

# Documentation and source control.
docs
*.md
!public/widget/documentation.md
.git
.gitignore
.github
.aiignore

# Editors and OS
.idea
.vscode
*.swp
*.swo
.DS_Store

# Container build files are not needed inside the image.
Dockerfile
.dockerignore
docker-compose*.yml

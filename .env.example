# Chatbot Server Environment Variables

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# If using Docker, the test database is available on port 27018 (see docs/DOCKER.md)
MONGODB_URI=mongodb://localhost:27017/chatbot
MONGODB_TEST_URI=mongodb://localhost:27017/chatbot-test
# For Docker setup, use: MONGODB_TEST_URI=mongodb://localhost:27018/chatbot-test

# Session Configuration
SESSION_SECRET=your-secure-session-secret

# JWT Configuration
JWT_SECRET=your-secure-jwt-secret
JWT_EXPIRATION=24h

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4

# Security
# Add allowed domains separated by commas - DO NOT use wildcards (*) in production
ALLOWED_DOMAINS=http://localhost:3000,http://localhost:8080,https://yourdomain.com

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:8080,https://yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Data Retention (in days)
ACTIVE_RETENTION_DAYS=180
ARCHIVED_RETENTION_DAYS=365
DATA_ANONYMIZATION_DAYS=90

# Backup Configuration
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_HOURS=24

# Monitoring & Alerting
ALERTS_ENABLED=true
EMAIL_ALERTS_ENABLED=false
ALERT_RECIPIENTS=admin@example.com,ops@example.com
ALERT_CHECK_INTERVAL=60000
LOG_LEVEL=info

# SMTP Configuration (for alerts)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=alerts@example.com
SMTP_PASSWORD=your-smtp-password

# Widget Update
WIDGET_VERSION=1.0.0

# Encryption Settings
ENCRYPTION_KEY_ROTATION_DAYS=30
ENABLE_PERFECT_FORWARD_SECRECY=true

# Feature Flags
ENABLE_AI_FILTERING=true
ENABLE_FILE_UPLOADS=true
ENABLE_ENCRYPTION_INDICATORS=true

# --- Production hardening ---
# Required in production; must not be the built-in development values.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_to_a_random_32_plus_character_string
# Number of reverse proxies in front of the app (needed for secure cookies + rate limiting)
TRUST_PROXY=1
# MongoDB connection pool size
MONGO_POOL_SIZE=20
# Backups shell out to mongodump; opt in explicitly
BACKUPS_ENABLED=false
# Maximum chat attachment size in bytes (default 10 MB)
MAX_UPLOAD_BYTES=10485760

# --- Knowledge retrieval ---
# Embedding model used for knowledge search and intent matching.
EMBEDDING_MODEL=text-embedding-3-small
# Optional: a dedicated vector database. Without either of these, vectors are
# stored in MongoDB and ranked in process (fine up to ~20k chunks per tenant).
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# MONGODB_VECTOR_INDEX=knowledge_vector_index
# Maximum PDF size to ingest, in bytes (default 25 MB)
MAX_PDF_BYTES=26214400

# --- Workflow action nodes ---
# Credentials for a tenant's own API are stored encrypted. Set this to keep them
# independent of SESSION_SECRET; without it the key is derived from
# SESSION_SECRET, and rotating that makes stored credentials undecryptable.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SECRETS_KEY=
# Action URLs must be https, so a tenant's API key is not sent in clear text.
# Set this only for local development against a plain-HTTP service.
# ACTIONS_ALLOW_HTTP=false
# Sent on every outbound action request. Some APIs reject an anonymous client.
# ACTIONS_USER_AGENT=chatbot-platform-workflow-action/1.0

# --- Plans and billing ---
# Plan definitions live in config/plans.js. A company's plan is stored in the
# database and changed via PATCH /api/billing/companies/:id/subscription,
# which is the seam a payment processor's webhook should call.

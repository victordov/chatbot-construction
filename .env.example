# Chatbot Platform configuration
#
# Copy to .env for local development, or pass these as environment variables
# in deployment. Every key here is read by the code; a key that nothing reads
# is not listed. Generate any secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# =============================================================================
# Server
# =============================================================================
PORT=3000
# development | production | test. In production the server refuses to start
# without MONGODB_URI, JWT_SECRET, SESSION_SECRET (32+ chars, not the built-in
# development values) and OPENAI_API_KEY.
NODE_ENV=development
# The address customers reach the platform at. Used to build links that leave
# the server: password-reset emails, the widget embed snippet, the email
# channel's inbound URL. Without it the reset link points at localhost.
PUBLIC_URL=http://localhost:3000
# Number of reverse proxies in front of the app, so secure cookies and rate
# limiting see the real client address. Defaults to 1 in production, off
# otherwise. Also accepts true/false, a CIDR, or "loopback".
TRUST_PROXY=1
# error | warn | info | debug
LOG_LEVEL=info
# Origins allowed to load the widget besides the ones each tenant registers
# under Allowed domains. Comma separated. Do not use * in production.
ALLOWED_DOMAINS=http://localhost:3000,http://localhost:8080

# =============================================================================
# Database
# =============================================================================
MONGODB_URI=mongodb://localhost:27017/chatbot
# Connection pool size (default 20).
MONGO_POOL_SIZE=20

# =============================================================================
# Secrets
# =============================================================================
# Signs auth tokens. Required in production, min 32 characters.
JWT_SECRET=change_me_to_a_random_32_plus_character_string
# Signs the session cookie. Required in production, min 32 characters.
SESSION_SECRET=change_me_to_a_different_random_32_plus_character_string
# Encrypts credentials tenants store for workflow action nodes. Set this to keep
# them independent of SESSION_SECRET; without it the key is derived from
# SESSION_SECRET, and rotating that makes stored credentials undecryptable.
# SECRETS_KEY=

# =============================================================================
# OpenAI
# =============================================================================
# REQUIRED in production: without a model the bot cannot answer anything a
# workflow does not script. In development it is optional (AI replies off).
OPENAI_API_KEY=
# Model for assistant replies and workflow LLM nodes.
OPENAI_MODEL=gpt-4o
# Cheaper model used for classification (intent, suggestions).
OPENAI_CLASSIFIER_MODEL=gpt-4o-mini
# Per-request timeout to OpenAI, in milliseconds (default 30000).
OPENAI_TIMEOUT_MS=30000
# Embedding model used for knowledge search and intent matching.
EMBEDDING_MODEL=text-embedding-3-small

# =============================================================================
# Knowledge base and retrieval
# =============================================================================
# Optional dedicated vector database. Without either of these, vectors are
# stored in MongoDB and ranked in process, which is fine up to roughly
# VECTOR_SCAN_LIMIT chunks per tenant (default 20000; a warning is logged above
# it). MongoDB stays the system of record in every mode.
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=knowledge_base
# MONGODB_VECTOR_INDEX=knowledge_vector_index
# VECTOR_SCAN_LIMIT=20000
# Largest PDF a tenant may import, in bytes (default 25 MB).
MAX_PDF_BYTES=26214400
# Largest web page a tenant may import, in bytes (default 2 MB).
MAX_PAGE_BYTES=2097152
# Largest file a tenant may upload into the knowledge base (PDF, .txt, .md,
# .csv, .html), in bytes (default 10 MB). Read in memory and never written to
# disk, so this is also the most one upload can hold in RAM.
KNOWLEDGE_UPLOAD_MAX_BYTES=10485760
# Website crawl (POST /api/knowledge/crawl): the most pages one crawl may read,
# whatever the request asks for (default 50; a request defaults to 20), and
# how long one crawl may take in total, in milliseconds (default 60000).
KNOWLEDGE_CRAWL_MAX_PAGES=50
KNOWLEDGE_CRAWL_TIME_BUDGET_MS=60000

# =============================================================================
# Chat attachments
# =============================================================================
# Maximum attachment size in bytes (default 10 MB). Files are stored on local
# disk under uploads/, so mount a volume there in production.
MAX_UPLOAD_BYTES=10485760

# =============================================================================
# Running more than one instance
# =============================================================================
# socket.io adapter. Required as soon as there is more than one app instance,
# so an operator connected to one instance can reach a visitor on another.
# REDIS_URL=redis://localhost:6379
# Background jobs (data retention, alerting, backups, webhook retries, deadline
# reminders, nightly tenant backups) run on every instance where this is true.
# With more than one instance, set it to true on exactly one and false on the
# rest. Metrics collection and /metrics are unaffected. Default true.
SCHEDULER_ENABLED=true
# How long a conversation waits for its operator to reconnect before it goes
# back to the queue, in milliseconds (default 60000).
OPERATOR_GRACE_MS=60000
# How often a connected dashboard re-checks that its user is still active,
# signed in and in an active company (milliseconds). A deactivated operator
# stops receiving conversations within this long.
SOCKET_REAUTH_MS=60000
# How long an instance keeps a tenant's published workflow before checking for
# a newer one, in milliseconds (default 30000). Bounds how long a publish
# takes to reach every instance.
WORKFLOW_CACHE_TTL_MS=30000
# Choosing which live workflow takes a message by what the visitor wants: how
# sure the cheap model must be (0-1) and how long it may take before the
# assistant answers instead (milliseconds).
WORKFLOW_PICK_THRESHOLD=0.45
WORKFLOW_PICK_TIMEOUT_MS=4000
# Workflow run counts are written in batches at most this often (milliseconds).
WORKFLOW_STATS_FLUSH_MS=30000
# A web chat nobody has written in for this many hours is ended, so it leaves
# the queue and counts as finished in reports (default 24).
IDLE_CLOSE_HOURS=24

# Push notifications to operators' phones and desktops (the installable app).
# Generate with: node scripts/generate-vapid-keys.js ops@yourcompany.com
# Without all three, push is off and the dashboard says so. Keep the private
# key as secret as JWT_SECRET, and do not rotate it casually.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# =============================================================================
# Rate limiting
# =============================================================================
# Counts are shared through MongoDB, so a limit means the same thing however
# many instances are running. Authenticated traffic takes its allowance from
# the tenant's plan (apiRequestsPerMinute); these are the fallbacks for traffic
# that has not proved who it is. Per minute unless stated.
RATE_LIMIT_API_MAX=100
RATE_LIMIT_CHAT_MAX=20
# A signed-in dashboard user gets at least this many requests a minute, even
# on a plan whose apiRequestsPerMinute is lower: one page load is a dozen
# requests. The plan's number still applies to API keys (/api/v1).
RATE_LIMIT_DASHBOARD_MIN=300
# Email verification codes a tenant may send in an hour (the in-chat "verify
# your email" step). Per session and per address there are fixed, lower caps.
VERIFY_EMAIL_HOURLY_LIMIT=200
# Failed sign-ins per hour, per address and account.
RATE_LIMIT_AUTH_MAX=10
# Failed sign-ins per hour from one address regardless of account.
RATE_LIMIT_AUTH_IP_MAX=50
# Password-reset requests per hour per address.
RATE_LIMIT_PASSWORD_RESET_MAX=5

# =============================================================================
# Retention
# =============================================================================
# Platform defaults, in days since a conversation's last activity. A company
# can set its own policy in Settings, which overrides these; 0 or unset means
# never. ARCHIVED_RETENTION_DAYS is still read as a legacy alias for
# RETENTION_DELETE_DAYS.
RETENTION_ANONYMIZE_DAYS=
RETENTION_DELETE_DAYS=
# Audit log entries, in days. Kept forever is a liability, not a default.
AUDIT_RETENTION_DAYS=400
# Webhook delivery attempts kept for debugging, in days.
WEBHOOK_LOG_RETENTION_DAYS=30

# =============================================================================
# Backups
# =============================================================================
# Whole-database backups shell out to mongodump (not installed in the Docker
# image by default; see Dockerfile). Written to backups/.
BACKUPS_ENABLED=false
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
# Nightly per-tenant document exports, so one customer can be restored without
# restoring every other customer with them. No mongodump needed.
TENANT_BACKUPS_ENABLED=false
TENANT_BACKUP_RETENTION_DAYS=90

# =============================================================================
# Monitoring and alerting
# =============================================================================
# Prometheus metrics at /metrics. In production the endpoint is only exposed
# when this is set, and the scraper must send it as a bearer token.
METRICS_TOKEN=
# Threshold alerts on response time and error rate, checked every
# ALERT_CHECK_INTERVAL milliseconds. Runs on the SCHEDULER_ENABLED instance.
ALERTS_ENABLED=false
EMAIL_ALERTS_ENABLED=false
ALERT_RECIPIENTS=ops@example.com
ALERT_CHECK_INTERVAL=60000
ALERT_FROM_EMAIL=alerts@example.com

# SMTP used by the platform itself: alert emails, password resets, sign-up
# confirmations, invitations and usage warnings. This is the operator's mail
# server, not a tenant's. Without it, outside production, the links those
# emails would carry are written to the log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Sender of password-reset mail (falls back to ALERT_FROM_EMAIL).
SMTP_FROM=no-reply@example.com

# =============================================================================
# Email as a support channel
# =============================================================================
# Outbound side of the email channel: replies operators write to customers who
# wrote in by email are sent through this server. Inbound mail arrives via the
# per-tenant webhook shown under Settings -> Email. Distinct from SMTP_* above
# because customer-facing mail and alert mail usually go through different
# providers and reputations.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
# Replies go out From this address, with the tenant's support address as
# Reply-To, so they pass SPF and DMARC for the platform's own domain. The
# display name reads "<Reply as> (via PRODUCT_NAME)". Also used to email a
# chat visitor who left before an operator answered.
EMAIL_FROM=support@example.com
# Send From the tenant's own address instead. Only when this deployment's mail
# provider has verified those domains; otherwise the replies land in spam.
EMAIL_ALLOW_TENANT_FROM=false

# =============================================================================
# Google (optional: spreadsheet import)
# =============================================================================
# OAuth client for connecting a user's Google account from the dashboard. The
# redirect URI must be registered in Google Cloud exactly as written here.
# See docs/GOOGLE_OAUTH_SETUP.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/oauth2callback
# Show the Google Sheets card on Bot -> Knowledge. Off: imported rows are not
# yet used in answers (a CSV upload is), so the card only confused people.
GOOGLE_SHEETS_UI=false
# Alternative server-to-server access with a service account (either name is
# accepted for the email; the key is the JSON key's private_key with newlines
# as \n).
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY=

# =============================================================================
# Google Calendar (optional: Bot -> Booking)
# =============================================================================
# OAuth client (type "Web application") tenants connect their Google Calendar
# with, scopes calendar.events and calendar.readonly. Falls back to
# GOOGLE_CLIENT_ID/SECRET above. Its authorised redirect URI must be exactly
# the one below; without it, PUBLIC_URL + /api/booking/google/callback.
# Cal.com and Calendly need nothing here: tenants paste their own key.
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/booking/google/callback

# =============================================================================
# Workflow action nodes and outbound webhooks
# =============================================================================
# Action URLs must be https so a tenant's API key is not sent in clear text.
# Set this only for local development against a plain-HTTP service.
# ACTIONS_ALLOW_HTTP=false
# User-Agent sent on outbound action requests and webhook deliveries. Some APIs
# reject an anonymous client.
# ACTIONS_USER_AGENT=chatbot-platform-workflow-action/1.0
# WEBHOOK_USER_AGENT=chatbot-platform-webhooks/1.0

# =============================================================================
# Accounts: the product's name, sign-up and sign-in
# =============================================================================
# The name on the sign-in pages, the dashboard's browser tab and the account
# emails (confirmation, invitations, usage warnings). Default "Support Desk".
PRODUCT_NAME=Support Desk
# Self-serve sign-up at /admin/signup.html: a new company on the trial, its
# first admin signed straight in, the address confirmed by email. Set to false
# to take new customers by invitation only.
SIGNUP_ENABLED=true
# Sign-ups per hour from one address (default 5); links from account emails
# (invitations, confirmations) per hour per address (default 30); confirmation
# emails one person may ask to have resent per hour (default 5).
# RATE_LIMIT_SIGNUP_MAX=5
# RATE_LIMIT_ACCOUNT_LINK_MAX=30
# RATE_LIMIT_VERIFY_RESEND_MAX=5
# "Sign in with Google" for people who already have an account (nobody gets
# an account through Google). An OAuth client of type "Web application" whose
# authorised redirect URI is PUBLIC_URL + /api/auth/google/callback. Leave
# empty to hide the button.
GOOGLE_SIGNIN_CLIENT_ID=
GOOGLE_SIGNIN_CLIENT_SECRET=

# =============================================================================
# Plans and payments (Stripe)
# =============================================================================
# What one AI reply is assumed to cost the platform, in dollars, for the
# estimate on Usage by tenant (default 0.002). An estimate for spotting a
# tenant who costs more than they pay, not for accounting.
AI_COST_PER_REPLY=0.002
# Plan definitions live in config/plans.js. New companies start on a trial of
# this many days (default 14).
TRIAL_DAYS=14
# Card details never reach this server: the customer pays on Stripe's own page
# and Stripe posts the result to /api/billing/webhook/stripe. The signing
# secret authenticates that message; without it the webhook refuses everything.
STRIPE_WEBHOOK_SECRET=
# Secret API key (sk_live_... / sk_test_..., or a restricted key with write
# access to Checkout Sessions and Billing Portal sessions). Lets a company
# admin start a Checkout or open the Billing Portal from Plan & Usage. Unset:
# no checkout button, and POST /api/billing/checkout answers 503. Success and
# cancel URLs are built from PUBLIC_URL.
STRIPE_SECRET_KEY=
# Which Stripe price corresponds to which plan. A price with no entry here
# leaves the tenant's plan untouched rather than being guessed at, and a plan
# with no price cannot be bought through the in-product checkout.
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=
# Let a Checkout Session identify the tenant by client_reference_id (what a
# Payment Link can carry) as well as by metadata.companyId. Off by default,
# because the reference is typed into a URL by whoever sends the link.
STRIPE_ALLOW_CLIENT_REFERENCE=false

# ---- Agencies and per-resolution pricing (P2F) ----
# Every price below is a placeholder until the owner decides it; the figure
# shown is the fallback config/plans.js uses when the variable is unset.
# The Agency plan: monthly price, client companies included, price of each
# client beyond that, the most clients one agency may hold unless a
# superadmin sets its own limit, and the plan its paid-for clients go on.
PLAN_AGENCY_PRICE=299
PLAN_AGENCY_CLIENTS_INCLUDED=10
PLAN_AGENCY_CLIENT_PRICE=19
PLAN_AGENCY_CLIENT_LIMIT=50
PLAN_AGENCY_CLIENT_PLAN=professional
# Professional paid per resolution instead of flat: a base fee, a price per
# conversation the bot resolves, and resolutions free each month.
PRICE_PER_RESOLUTION_BASE=49
PRICE_PER_RESOLUTION=0.49
PRICE_INCLUDED_RESOLUTIONS=0
# Stripe for the above. STRIPE_PRICE_AGENCY is the Agency plan's monthly
# price. Per resolution needs a Billing Meter (sum aggregation) whose event
# name is STRIPE_RESOLUTION_EVENT, a metered price on it (STRIPE_PRICE_RESOLUTION)
# and, when the base fee is not 0, a monthly price for it per plan
# (STRIPE_PRICE_PROFESSIONAL_PER_RESOLUTION). Without the key and the metered
# price, resolutions are counted and shown but never reported to Stripe.
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_RESOLUTION=
STRIPE_PRICE_PROFESSIONAL_PER_RESOLUTION=
STRIPE_RESOLUTION_EVENT=resolutions

# =============================================================================
# Tests
# =============================================================================
# `npm test` starts an in-memory MongoDB. Set this to run the suite against a
# real server instead.
# MONGODB_TEST_URI=mongodb://localhost:27017/chatbot-test
